# ====================================================
# SupplySense Enterprise Configuration Template (.env.example)
# Copy this file to .env and fill in your secrets.
# ====================================================

# ----------------------------------------------------
# Application Configuration
# ----------------------------------------------------
APP_NAME=SupplySense
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ----------------------------------------------------
# Database Configuration (Neon PostgreSQL)
# ----------------------------------------------------
DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-divine-waterfall-axacogw5.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require

# ----------------------------------------------------
# Security Configuration
# ----------------------------------------------------
SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-key-in-production!
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------
# AI Provider Configuration (Groq / OpenAI)
# ----------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ----------------------------------------------------
# Observability Configuration (LangSmith)
# ----------------------------------------------------
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=SupplySense-Enterprise

# ----------------------------------------------------
# Vector Store Configuration (Qdrant)
# ----------------------------------------------------
VECTORSTORE_PROVIDER=qdrant
QDRANT_URL=https://your-cluster-id.qdrant.tech
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=supplysense_knowledge

# Optional Local Qdrant Server Settings (if not using Qdrant Cloud)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ----------------------------------------------------
# Embeddings Configuration
# ----------------------------------------------------
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HUGGINGFACE_EMBEDDING_MODEL=all-MiniLM-L6-v2
